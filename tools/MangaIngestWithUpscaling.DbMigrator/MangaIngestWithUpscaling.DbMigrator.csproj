<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NETSDK1187: MudBlazor.Translations ships a 'ckb-iq' resource folder that the SDK normalizes to 'ckb-IQ' (pulled in transitively via the web app). -->
    <NoWarn>$(NoWarn);NETSDK1206;CS8669;NETSDK1187</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MangaIngestWithUpscaling.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- References the web application solely to reach the concrete BaseTask types that
         TaskJsonOptionsProvider needs to deserialize PersistedTask.Data polymorphically. That pulls
         NetVips/MudBlazor/gRPC into this CLI (hence the NETSDK1187 suppression above). A shared
         "task contracts" assembly would decouple it; tracked as a follow-up, not done here. -->
    <ProjectReference Include="..\..\src\MangaIngestWithUpscaling\MangaIngestWithUpscaling.csproj" />
    <ProjectReference Include="..\..\src\MangaIngestWithUpscaling.Data\MangaIngestWithUpscaling.Data.csproj" />
    <ProjectReference Include="..\..\src\MangaIngestWithUpscaling.Data.Sqlite\MangaIngestWithUpscaling.Data.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\MangaIngestWithUpscaling.Data.Postgres\MangaIngestWithUpscaling.Data.Postgres.csproj" />
  </ItemGroup>
</Project>
