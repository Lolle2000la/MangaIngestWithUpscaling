{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "14 days",
  "packageRules": [
    {
      "description": "Bundle all NetVips updates",
      "matchPackageNames": ["NetVips*"],
      "groupName": "NetVips",
      "automerge": true
    },
    {
      "description": "Bundle all ReactiveUI updates",
      "matchPackageNames": ["ReactiveUI", "ReactiveUI.Blazor", "ReactiveUI*"],
      "groupName": "ReactiveUI",
      "automerge": true
    },
    {
      "description": "Bundle all MudBlazor updates",
      "matchPackageNames": ["MudBlazor*"],
      "groupName": "MudBlazor",
      "automerge": true
    },
    {
      "description": "Bundle all EFCore updates",
      "matchPackageNames": ["Microsoft.EntityFrameworkCore*"],
      "groupName": "Entity Framework Core",
      "automerge": true
    },
    {
      "description": "Bundle all ASP.NET Core updates",
      "matchPackageNames": ["Microsoft.AspNetCore*"],
      "groupName": "ASP.NET Core",
      "automerge": true
    },
    {
      "description": "Bundle all Serilog updates",
      "matchPackageNames": ["Serilog*"],
      "groupName": "Serilog",
      "automerge": true
    },
    {
      "description": "Automerge all updates if they build",
      "matchPackageNames": ["*"],
      "automerge": true
    },
    {
      "description": "Do not auto-upgrade .NET to a new major version; stay on the current LTS line (10.x) until .NET 11 is released and adopted deliberately",
      "matchDatasources": ["docker", "nuget"],
      "matchPackageNames": [
        "mcr.microsoft.com/dotnet/*",
        "Microsoft.AspNetCore*",
        "Microsoft.EntityFrameworkCore*",
        "Microsoft.Extensions.*"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Microsoft.Build 18.10+ targets .NET 11, but the app deliberately stays on .NET 10 LTS; stay on the 18.9.x line until .NET 11 is adopted",
      "matchPackageNames": [
        "Microsoft.Build",
        "Microsoft.Build.Framework",
        "Microsoft.Build.Tasks.Core",
        "Microsoft.Build.Utilities.Core"
      ],
      "allowedVersions": "<18.10"
    }
  ]
}
