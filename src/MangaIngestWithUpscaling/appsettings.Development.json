{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.SQLite" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Server.Kestrel": "Error",
        "Microsoft.EntityFrameworkCore": "Warning",
        // The provider a session is built with is only interesting while developing, and it is
        // logged once per session (and once per provider probe), so it is Debug in production.
        "MangaIngestWithUpscaling.Shared.Services.Inference.OnnxSessionFactory": "Debug"
      }
    },
    "Enrich": [ "FromLogContext" ]
  },
   "Upscaler": {
     "UseFp16": true,
     "UseCPU": false,
     "SelectedDeviceIndex": 1, // 0 = CPU, 1 = first GPU/accelerator (WebGPU, CUDA, DirectML, OpenVINO, MIGraphX), 2 = second, etc.
     "RemoteOnly": false,
     "PreferredGpuBackend": "Auto", // Options: "Auto", "WebGPU", "CUDA", "DirectML", "OpenVINO", "MIGraphX", "CPU"
     "UpscaleTimeout": "00:01:00", // Per-million-pixel inactivity timeout. The effective timeout is scaled by image size: a 2 MP image gets 2× this value, a 0.5 MP image still gets the full value. Default: 1 minute.
   }
}
