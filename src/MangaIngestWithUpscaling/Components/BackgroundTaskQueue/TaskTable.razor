@using System.Globalization
@using MangaIngestWithUpscaling.Data.BackgroundTaskQueue
@using MangaIngestWithUpscaling.Services.BackgroundTaskQueue
@using MangaIngestWithUpscaling.Services.BackgroundTaskQueue.TaskDescribers
@implements IDisposable
@inject IStringLocalizer<TaskTable> Loc
@inject ITaskDescriberFactory DescriberFactory
@inject DistributedUpscaleTaskProcessor DistributedUpscaleTaskProcessor
@inject TaskRegistry TaskRegistry
@inject ILogger<TaskTable> Logger

<MudTable T="PersistedTask" ServerData="LoadServerData" RowsPerPage="10" Elevation="3" Dense="true" @ref="Table">
    <ToolBarContent>
        <MudText Typo="Typo.h6">@Title</MudText>
        <MudSpacer />
        <MudButton StartIcon="@Icons.Material.Filled.Delete" Variant="Variant.Outlined" Color="Color.Primary"
            OnClick="OnClearFailed">@Loc["ClearFailed"]
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.ClearAll" Variant="Variant.Filled" Color="Color.Primary"
            OnClick="OnClearCompleted">@Loc["ClearCompleted"]
        </MudButton>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>@Loc["Header_Name"]</MudTh>
        <MudTh>
            <MudTableSortLabel T="PersistedTask" SortLabel="CreatedAt">
                @Loc["Header_QueuedAt"]</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel T="PersistedTask" SortLabel="ProcessedAt">
                @Loc["Header_FinishedAt"]
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel T="PersistedTask" SortLabel="Status">@Loc["Header_Status"]
            </MudTableSortLabel>
        </MudTh>
        <MudTh>@Loc["Header_Actions"]</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@Loc["Header_Name"]">
            <TaskTitle Task="@context.Data" />
        </MudTd>
        <MudTd DataLabel="@Loc["Header_QueuedAt"]">@context.CreatedAt.ToLocalTime()</MudTd>
        <MudTd DataLabel="@Loc["Header_FinishedAt"]">@(context.ProcessedAt is not null ?
                        context.ProcessedAt.Value.ToLocalTime() : "")
        </MudTd>
        <MudTd DataLabel="@Loc["Header_Status"]">
            @Loc[$"Status_{context.Status}"]
            @if (context.Status == PersistedTaskStatus.Processing && DistributedUpscaleTaskProcessor.IsRunningRemotely(context.Id))
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="ml-1 my-0 pa-1" Style="font-size: 0.75rem;">
                    @Loc["Status_Remote"]
                </MudChip>
            }
            @if (context.Status == PersistedTaskStatus.Processing && context.Data?.Progress is not null)
            {
                var p = context.Data.Progress;
                <div style="font-size: 0.85em; color: var(--mud-palette-text-secondary); margin-top: 2px;">
                    <TaskProgressStatus TaskData="@context.Data" Progress="@p" />
                </div>
            }
        </MudTd>
        <MudTd DataLabel="@Loc["Header_Actions"]" Style="white-space: nowrap">
            @if (context.Status == PersistedTaskStatus.Pending)
            {
                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Variant="Variant.Text" Size="Size.Small"
                    OnClick="_ => OnRunNow.InvokeAsync(context)" />
            }
            else if (context.Status is PersistedTaskStatus.Failed or PersistedTaskStatus.Canceled)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Variant="Variant.Text" Size="Size.Small"
                    OnClick="_ => OnRetryFailed.InvokeAsync(context)" />
            }
            @if (context.Status == PersistedTaskStatus.Processing)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Cancel" Variant="Variant.Text" Color="Color.Error"
                    Size="Size.Small" OnClick="_ => OnCancel.InvokeAsync(context)" />
            }
            else
            {
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Variant="Variant.Text" Color="Color.Error"
                    Size="Size.Small" OnClick="_ => OnDelete.InvokeAsync(context)" />
            }
        </MudTd>
    </RowTemplate>
    <ChildRowContent>
        @if (context.Status == PersistedTaskStatus.Processing)
        {
            var p = context.Data?.Progress;
            <MudTd colspan="6" Class="pa-0">
                <div style="width: 100%; height: 4px;">
                    @if (p is null || p.IsIndeterminate || p.Total <= 0)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Style="height: 4px;" />
                    }
                    else
                    {
                        <MudProgressLinear Value="@(Math.Clamp((double)p.Current / p.Total * 100.0, 0, 100))"
                            Color="Color.Primary" Style="height: 4px;" />
                    }
                </div>
            </MudTd>
        }
    </ChildRowContent>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@code {
    /// <summary>Selects which registry view this table renders.</summary>
    [Parameter] public bool Upscale { get; set; }

    /// <summary>
    ///     Optional caller-supplied source. When non-null the table pages from this collection instead
    ///     of the registry snapshot, preserving the historical API. It is nullable so "not provided"
    ///     can be distinguished from an empty collection. The default registry-driven behavior is
    ///     used when it is not supplied.
    /// </summary>
    [Parameter] public IReadOnlyCollection<PersistedTask>? Tasks { get; set; }

    [Parameter] public string Title { get; set; } = "Tasks";

    [Parameter] public EventCallback OnClearCompleted { get; set; } = EventCallback.Empty;
    [Parameter] public EventCallback OnClearFailed { get; set; } = EventCallback.Empty;
    [Parameter] public EventCallback<PersistedTask> OnRetryFailed { get; set; } = EventCallback<PersistedTask>.Empty;
    [Parameter] public EventCallback<PersistedTask> OnCancel { get; set; } = EventCallback<PersistedTask>.Empty;
    [Parameter] public EventCallback<PersistedTask> OnRunNow { get; set; } = EventCallback<PersistedTask>.Empty;
    [Parameter] public EventCallback<PersistedTask> OnDelete { get; set; } = EventCallback<PersistedTask>.Empty;

    private MudTable<PersistedTask> Table { get; set; } = null!;

    // The registry flushes from background threads, so capture the circuit culture up front and
    // restore it whenever we render in response to one of those events.
    private CultureInfo _runTimeCulture = CultureInfo.CurrentUICulture;
    private int _reloadPending;
    private int _reloadRunning;
    private volatile bool _disposed;

    protected override void OnInitialized()
    {
        _runTimeCulture = CultureInfo.CurrentUICulture;

        if (Upscale)
            TaskRegistry.UpscaleTasksChanged += OnTasksChanged;
        else
            TaskRegistry.StandardTasksChanged += OnTasksChanged;
    }

    public void Dispose()
    {
        _disposed = true;

        if (Upscale)
            TaskRegistry.UpscaleTasksChanged -= OnTasksChanged;
        else
            TaskRegistry.StandardTasksChanged -= OnTasksChanged;
    }

    private void OnTasksChanged()
    {
        if (_disposed)
            return;

        // Registry flushes can raise many changes at once; coalesce reloads so we only page the
        // current data a handful of times instead of once per changed task.
        Interlocked.Exchange(ref _reloadPending, 1);

        // Only one reload loop may run at a time; concurrent bodies could interleave at the await
        // and issue redundant concurrent MudTable.ReloadServerData calls. Notifications are not
        // dropped: the running loop keeps draining the pending flag until it observes it clear.
        if (Interlocked.CompareExchange(ref _reloadRunning, 1, 0) == 1)
            return;

        _ = SafeReloadAsync();
    }

    private async Task SafeReloadAsync()
    {
        try
        {
            await InvokeAsync(ProcessPendingReloadAsync);
        }
        catch (Exception ex)
        {
            // The component may have been disposed between the check above and this call, or the
            // dispatcher may already be shutting down. Observe the fault and clear the flag so the
            // table is not permanently stuck if it is still alive.
            Interlocked.Exchange(ref _reloadPending, 0);
            Logger.LogDebug(ex, "Skipped a task table reload because the component is unavailable.");
        }
        finally
        {
            Interlocked.Exchange(ref _reloadRunning, 0);
        }

        // A change that arrived after the loop's last check but before the running flag was cleared
        // would have seen the flag set and not scheduled a reload. Re-check so it is not dropped.
        if (Volatile.Read(ref _reloadPending) == 1)
            OnTasksChanged();
    }

    private async Task ProcessPendingReloadAsync()
    {
        while (Interlocked.Exchange(ref _reloadPending, 0) == 1)
        {
            if (_disposed)
                return;

            try
            {
                CultureInfo.CurrentUICulture = _runTimeCulture;
                CultureInfo.CurrentCulture = _runTimeCulture;

                if (Table is not null)
                {
                    await Table.ReloadServerData();
                }
            }
            catch (Exception ex)
            {
                // Never let a reload failure escape into an unobserved task or spin the loop.
                // Clearing the pending flag stops SafeReloadAsync's re-check from immediately
                // re-dispatching while the failure persists.
                Interlocked.Exchange(ref _reloadPending, 0);
                Logger.LogError(ex, "Failed to reload the task table.");
                return;
            }
        }
    }

    private Task<TableData<PersistedTask>> LoadServerData(
        TableState state,
        CancellationToken cancellationToken
    )
    {
        // Materialize only the requested page. Both sources are used in their existing order for
        // the default view; an explicit column sort orders the source once per reload. The
        // registry's snapshots are already sorted, so the default ordering is identical for a
        // caller-supplied collection that comes from the same registry view.
        IReadOnlyCollection<PersistedTask> source =
            Tasks
            ?? (Upscale ? TaskRegistry.GetUpscaleSnapshot() : TaskRegistry.GetStandardSnapshot());

        IEnumerable<PersistedTask> ordered = ApplySort(source, state);
        int skip = state.Page * state.PageSize;
        List<PersistedTask> page = (skip > 0 ? ordered.Skip(skip) : ordered)
            .Take(state.PageSize)
            .ToList();

        return Task.FromResult(
            new TableData<PersistedTask> { Items = page, TotalItems = source.Count }
        );
    }

    private static IEnumerable<PersistedTask> ApplySort(
        IEnumerable<PersistedTask> source,
        TableState state
    )
    {
        if (state.SortDirection == SortDirection.None)
            return source;

        Func<PersistedTask, object?>? selector = state.SortLabel switch
        {
            "CreatedAt" => x => x.CreatedAt,
            "ProcessedAt" => x => x.ProcessedAt,
            "Status" => x => x.Status,
            _ => null,
        };

        if (selector is null)
            return source;

        return state.SortDirection == SortDirection.Ascending
            ? source.OrderBy(selector)
            : source.OrderByDescending(selector);
    }
}
