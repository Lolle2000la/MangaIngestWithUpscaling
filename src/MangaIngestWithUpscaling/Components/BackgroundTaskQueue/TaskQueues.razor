@using MangaIngestWithUpscaling.Data.BackgroundTaskQueue
@using MangaIngestWithUpscaling.Services.BackgroundTaskQueue
@using MangaIngestWithUpscaling.Shared.Services.QuietHours
@using System.Globalization
@implements IAsyncDisposable

@inject ILogger<TaskQueues> Logger
@inject ISnackbar Snackbar

@inject TaskQueue TaskQueue
@inject StandardTaskProcessor StandardTaskProcessor
@inject UpscaleTaskProcessor UpscaleTaskProcessor
@inject DistributedUpscaleTaskProcessor DistributedUpscaleTaskProcessor
@inject TaskRegistry TaskRegistry
@inject IQuietHoursGate QuietHours
@inject TimeProvider TimeProvider
@inject IStringLocalizer<TaskQueues> Loc

@page "/tasks"

<PageTitle>@Loc["PageTitle"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">@Loc["Title"]</MudText>

@if (_quietState.IsQuiet)
{
    <div class="d-flex mb-2" data-testid="quiet-hours-badge">
        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
            @Loc["QuietHours_Paused", _quietState.ResumeAtLocal?.ToString("HH:mm", CultureInfo.InvariantCulture) ?? string.Empty]
        </MudChip>
    </div>
}

<MudGrid>
    <MudItem lg="6" xs="12">
        <TaskTable @key="@("standard-tasks")" Upscale="false" Title="@Loc["StandardTasks"]" OnClearCompleted="OnClearCompletedStandardTasks"
            OnClearFailed="OnClearFailedStandardTasks" OnRetryFailed="OnRetryFailed" OnDelete="OnDelete"
            OnCancel="OnCancelStandardTask" OnRunNow="OnRunNow" />
    </MudItem>
    <MudItem lg="6" xs="12">
        <TaskTable @key="@("upscale-tasks")" Upscale="true" Title="@Loc["UpscalingTasks"]" OnClearCompleted="OnClearCompletedUpscaleTasks"
            OnClearFailed="OnClearFailedUpscaleTasks" OnRetryFailed="OnRetryFailed" OnDelete="OnDelete"
            OnCancel="OnCancelUpscaleTask" OnRunNow="OnRunNow" />
    </MudItem>
</MudGrid>

@code {
    private readonly CancellationTokenSource _quietHoursRefresh = new();
    private Task? _quietHoursRefreshTask;

    // The last quiet-hours state that was rendered. The refresh loop only re-renders when this
    // changes, because re-rendering the page for nothing costs both task tables and every clock on
    // them a round of interop.
    private (bool IsQuiet, TimeOnly? ResumeAtLocal) _quietState;

    // Snapshots are immutable arrays swapped atomically by the registry, so they are safe to
    // enumerate here while the registry flushes on a background thread.
    private IReadOnlyList<PersistedTask> standardTasks => TaskRegistry.GetStandardSnapshot();
    private IReadOnlyList<PersistedTask> upscaleTasks => TaskRegistry.GetUpscaleSnapshot();

    protected override Task OnInitializedAsync()
    {
        // The quiet-hours badge is read from an in-memory gate, so it has no event to subscribe to:
        // a coarse poll is enough to make it disappear when the schedule ends, and it stops on
        // navigation with the component.
        _quietState = CurrentQuietState();
        _quietHoursRefreshTask = RefreshQuietHoursBadgeAsync(_quietHoursRefresh.Token);
        return Task.CompletedTask;
    }

    private (bool IsQuiet, TimeOnly? ResumeAtLocal) CurrentQuietState() =>
        (QuietHours.IsQuiet, QuietHours.ResumeAtLocal);

    private async Task RefreshQuietHoursBadgeAsync(CancellationToken cancellationToken)
    {
        // Driven by the injected TimeProvider so the interval is testable instead of being tied to
        // the wall clock.
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30), TimeProvider);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                (bool IsQuiet, TimeOnly? ResumeAtLocal) current = CurrentQuietState();
                if (current == _quietState)
                {
                    continue;
                }

                _quietState = current;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Navigated away or disposed; nothing to clean up beyond the timer's own disposal.
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _quietHoursRefresh.CancelAsync();
        if (_quietHoursRefreshTask is not null)
        {
            // Await the loop so it cannot touch the disposed renderer after this returns.
            await _quietHoursRefreshTask;
        }

        _quietHoursRefresh.Dispose();
    }

    private async Task OnClearCompletedStandardTasks()
    {
        try
        {
            var completedTasks = standardTasks.Where(x => x.Status == PersistedTaskStatus.Completed).ToList();
            await TaskQueue.RemoveTasksAsync(completedTasks);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to clear completed tasks");
            Snackbar.Add(string.Format(Loc["Error_ClearCompleted"], ex.Message), Severity.Error);
            StateHasChanged();
        }
    }

    private async Task OnClearFailedStandardTasks()
    {
        try
        {
            var failedTasks = standardTasks.Where(x => x.Status == PersistedTaskStatus.Failed).ToList();
            await TaskQueue.RemoveTasksAsync(failedTasks);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to clear failed tasks");
            Snackbar.Add(string.Format(Loc["Error_ClearFailed"], ex.Message), Severity.Error);
            StateHasChanged();
        }
    }

    private async Task OnClearCompletedUpscaleTasks()
    {
        try
        {
            var completedTasks = upscaleTasks.Where(x => x.Status == PersistedTaskStatus.Completed).ToList();
            await TaskQueue.RemoveTasksAsync(completedTasks);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to clear completed tasks");
            Snackbar.Add(string.Format(Loc["Error_ClearCompleted"], ex.Message), Severity.Error);
            StateHasChanged();
        }
    }

    private async Task OnClearFailedUpscaleTasks()
    {
        try
        {
            var failedTasks = upscaleTasks.Where(x => x.Status == PersistedTaskStatus.Failed).ToList();
            await TaskQueue.RemoveTasksAsync(failedTasks);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to clear failed tasks");
            Snackbar.Add("Failed to clear failed tasks: " + ex.Message, Severity.Error);
            StateHasChanged();
        }
    }

    private async Task OnRetryFailed(PersistedTask task)
    {
        try
        {
            await TaskQueue.RetryAsync(task);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to retry task {TaskId}", task.Id);
            Snackbar.Add("Failed to retry task: " + ex.Message, Severity.Error);
            StateHasChanged();
        }
    }

    private async Task OnDelete(PersistedTask task)
    {
        try
        {
            await TaskQueue.RemoveTaskAsync(task);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete task {TaskId}", task.Id);
            Snackbar.Add("Failed to delete task: " + ex.Message, Severity.Error);
            StateHasChanged();
        }
    }

    private Task OnCancelStandardTask(PersistedTask task)
    {
        try
        {
            StandardTaskProcessor.CancelCurrent(task);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to cancel task {TaskId}", task.Id);
            Snackbar.Add("Failed to cancel task: " + ex.Message, Severity.Error);
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    private async Task OnCancelUpscaleTask(PersistedTask task)
    {
        try
        {
            UpscaleTaskProcessor.CancelCurrent(task);
            await DistributedUpscaleTaskProcessor.CancelCurrent(task);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to cancel task {TaskId}", task.Id);
            Snackbar.Add("Failed to cancel task: " + ex.Message, Severity.Error);
            StateHasChanged();
        }
    }

    private async Task OnRunNow(PersistedTask task)
    {
        try
        {
            await TaskQueue.MoveToFrontAsync(task);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to move task {TaskId} to the front", task.Id);
            Snackbar.Add(string.Format(Loc["Error_RunNow"], ex.Message), Severity.Error);
            StateHasChanged();
        }
    }
}
