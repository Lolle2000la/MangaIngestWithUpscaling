@using MangaIngestWithUpscaling.Data.LibraryManagement
@using MangaIngestWithUpscaling.Shared.Data.LibraryManagement
@using MangaIngestWithUpscaling.Services.MangaManagement
@using Microsoft.Extensions.Localization
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IMangaLibraryMover MangaMover
@inject IStringLocalizer<MoveMangasToLibraryDialog> Loc

<MudDialog>
    <DialogContent>
        <MudStack>
            <MudText>
                @(Mangas.Count > 1 ? Loc["Title_Multiple", Mangas.Count] :
                                Loc["Title_Single", Mangas.First().PrimaryTitle])
            </MudText>
            <MudText Color="Color.Error">
                @((MarkupString)Loc["Warning_MoveFiles"].Value)
            </MudText>
            <MudSelect Label="@Loc["SelectLibrary"]" T="Library" @bind-Value="selected">
                @foreach (var library in libraries)
                {
                    <MudSelectItem T="Library" Value="@library">@library.Name</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Loc["Button_Cancel"]</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.MergeType" Color="Color.Primary" Variant="Variant.Filled"
            Disabled="selected == null" OnClick="Submit">@Loc["Button_Move"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public required List<Manga> Mangas { get; set; }

    private Library? selected;
    private List<Library> libraries = new();

    protected override async Task OnInitializedAsync()
    {
        // Materialize once: enumerating the DbSet in the render tree runs a synchronous query.
        await using var db = await DbContextFactory.CreateDbContextAsync();
        libraries = await db.Libraries.AsNoTracking().ToListAsync();
    }

    async Task Submit()
    {
        if (selected == null)
        {
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var targetLibrary = await db.Libraries.FindAsync(selected.Id);
        if (targetLibrary is null)
        {
            MudDialog.Cancel();
            return;
        }

        foreach (var manga in Mangas)
        {
            var trackedManga = await db.MangaSeries.FindAsync(manga.Id);
            if (trackedManga is null)
            {
                continue;
            }

            await MangaMover.MoveMangaAsync(trackedManga, targetLibrary, context: db);
        }
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}