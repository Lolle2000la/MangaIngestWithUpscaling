@using MangaIngestWithUpscaling.Data.LibraryManagement
@using MangaIngestWithUpscaling.Shared.Data.LibraryManagement
@using MangaIngestWithUpscaling.Services.MangaManagement
@using Microsoft.Extensions.Localization
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IMangaMerger MangaMerger
@inject IStringLocalizer<MergeMangaDialog> Loc

<MudDialog>
    <DialogContent>
        <MudStack>
            <MudText>@(Mangas.Count > 1 ? Loc["Title_Multiple", Mangas.Count] :
                                Loc["Title_Single", Mangas.First().PrimaryTitle])</MudText>
            <MudSelect Label="@Loc["SelectPrimary"]" T="Manga" @bind-Value="primary">
                @foreach (var manga in Mangas)
                {
                    <MudSelectItem T="Manga" Value="@manga">@manga.PrimaryTitle</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Loc["Button_Cancel"]</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.MergeType" Color="Color.Primary" Variant="Variant.Filled"
            Disabled="primary == null" OnClick="Submit">@Loc["Button_Merge"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public required List<Manga> Mangas { get; set; }

    private Manga? primary;

    async Task Submit()
    {
        if (primary == null)
        {
            return;
        }

        // The mangas were supplied by a MudTable ServerData query that opens a fresh, no-tracking
        // context per call. Identity is only resolved within one query, so two rows from different
        // pages/filters can carry distinct Library instances with the same key. Passing that graph
        // to the merger would make EF graph-attach throw, so reload the roots tracked by id in one
        // context and hand that context to the merger (mirrors MoveMangasToLibraryDialog).
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var trackedPrimary = await db
            .MangaSeries.Include(m => m.Library)
            .FirstOrDefaultAsync(m => m.Id == primary.Id);
        if (trackedPrimary is null)
        {
            MudDialog.Cancel();
            return;
        }

        var trackedToBeMerged = new List<Manga>();
        foreach (var manga in Mangas)
        {
            if (manga.Id == primary.Id)
            {
                continue;
            }

            var tracked = await db
                .MangaSeries.Include(m => m.Library)
                .FirstOrDefaultAsync(m => m.Id == manga.Id);
            if (tracked is not null)
            {
                trackedToBeMerged.Add(tracked);
            }
        }

        if (trackedToBeMerged.Count == 0)
        {
            MudDialog.Cancel();
            return;
        }

        await MangaMerger.MergeAsync(trackedPrimary, trackedToBeMerged, context: db);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}