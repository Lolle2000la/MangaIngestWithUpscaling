@page "/logs"
@using MangaIngestWithUpscaling.Data.LogModel
@using MangaIngestWithUpscaling.Services.Logging
@using Serilog.Events
@inject IDbContextFactory<LoggingDbContext> DbContextFactory
@inject IDialogService DialogService
@inject IStringLocalizer<Logs> Loc

<PageTitle>@Loc["PageTitle"]</PageTitle>

<MudTable T="Log" Items="@_logs" Hover="true" ServerData="@ServerData" SortLabel="Timestamp" @ref="table"
    HorizontalScrollbar="true" Dense="true" Breakpoint="Breakpoint.None" OnRowClick="OnRowClick">
    <ToolBarContent>
        <MudText Typo="Typo.h6">@Loc["Title"]</MudText>
        <MudSpacer />
        <MudSelect @bind-Value="_selectedLevel" @bind-Value:after="OnFilterChanged"
            Label="@Loc["FilterLabel"]" Immediate="true">
            @foreach (var level in Enum.GetValues<LogEventLevel>())
            {
                <MudSelectItem Value="@level">@level.ToString()</MudSelectItem>
            }
        </MudSelect>
    </ToolBarContent>

    <HeaderContent>
        <MudTh>@Loc["Header_Timestamp"]</MudTh>
        <MudTh>@Loc["Header_Level"]</MudTh>
        <MudTh>@Loc["Header_Message"]</MudTh>
        <MudTh>@Loc["Header_Exception"]</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="@Loc["Header_Timestamp"]">
            <LocalTime Value="@context.Timestamp" />
        </MudTd>

        <MudTd DataLabel="@Loc["Header_Level"]">
            <MudChip T="string" Color="@GetLevelColor(context.Level)" Variant="Variant.Filled" Class="ma-1">
                @context.Level
            </MudChip>
        </MudTd>

        <MudTd DataLabel="@Loc["Header_Message"]" Class="log-message">
            <div class="log-message">
                <MudText title="@context.RenderedMessage">@context.RenderedMessage</MudText>
            </div>
        </MudTd>

        <MudTd DataLabel="@Loc["Header_Exception"]">
            @if (!string.IsNullOrEmpty(context.Exception))
            {
                <div class="log-message">
                    <MudText title="@context.Exception">@context.Exception</MudText>
                </div>
            }
        </MudTd>
    </RowTemplate>

    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@code {
    private List<Log> _logs = new();
    private LogEventLevel _selectedLevel = LogEventLevel.Warning;

    private MudTable<Log> table = null!;

    private async Task<TableData<Log>> ServerData(TableState state, CancellationToken cancellationToken)
    {
        // Open a short-lived context per request instead of injecting the circuit-scoped one: rapid
        // filter/sort reloads can otherwise overlap and hit "A second operation was started on this
        // context instance".
        await using var dbContext = await DbContextFactory.CreateDbContextAsync(cancellationToken);
        IQueryable<Log> query = dbContext.Logs;

        // Serilog's level names ("Verbose"…"Fatal"), not Microsoft.Extensions.Logging's
        // ("Trace"…"Critical"), because those are what the sinks persist.
        var logLevels = LogLevelFilter.AtOrAbove(_selectedLevel);

        query = query.Where(log => logLevels.Contains(log.Level));

        query = state.SortLabel switch
        {
            "Timestamp" => (state.SortDirection == SortDirection.Ascending)
            ? query.OrderBy(log => log.Timestamp)
            : query.OrderByDescending(log => log.Timestamp),
            _ => query.OrderByDescending(log => log.Timestamp)
        };

        var totalItems = await query.CountAsync(cancellationToken);
        var items = await query
        .Skip(state.Page * state.PageSize)
        .Take(state.PageSize)
        .ToListAsync(cancellationToken);

        return new TableData<Log> { TotalItems = totalItems, Items = items };
    }

    /// <summary>
    ///     Reloads after the severity filter changed. The table is reset to the first page because
    ///     MudTable only clamps the page when its start is strictly past the end; a filter that
    ///     leaves exactly a page-size multiple of rows would otherwise keep an out-of-range page and
    ///     render blank.
    /// </summary>
    private async Task OnFilterChanged()
    {
        if (table is null)
            return;

        if (table.CurrentPage != 0)
        {
            // NavigateTo(0) changes the page and triggers its own server reload with the new filter.
            table.NavigateTo(0);
            return;
        }

        await table.ReloadServerData();
    }

    private Color GetLevelColor(string level)
    {
        return level?.ToUpper() switch
        {
            "ERROR" => Color.Error,
            "WARNING" => Color.Warning,
            "INFORMATION" => Color.Info,
            "DEBUG" => Color.Default,
            _ => Color.Default
        };
    }

    private async Task OnRowClick(TableRowClickEventArgs<Log> args)
    {
        if (args.Item != null)
        {
            await ShowLogDialog(args.Item);
        }
    }

    private async Task ShowLogDialog(Log log)
    {
        var parameters = new DialogParameters { ["Log"] = log };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<LogDetailDialog>("Log Details", parameters, options);
    }
}