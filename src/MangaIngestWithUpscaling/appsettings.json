{
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=data.db;Mode=ReadWriteCreate",
    // Placeholder for local development only (matches docker-compose). Set a real connection
    // string, or Ingest_ConnectionStrings__PostgresConnection, when DatabaseProvider is Postgres.
    "PostgresConnection": "Host=localhost;Database=manga_ingest;Username=postgres;Password=postgres",
    "LoggingConnection": "Data Source=logs.db"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.SQLite"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Server.Kestrel": "Error",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  // "Kavita": {
  //   "BaseUrl": null,
  //   "ApiKey": null,
  //   "Enabled": false
  // },
  // "Upscaler": {
  //   "UseFp16": null, // Optional: true = FP16, false = FP32, null = auto-detect based on GPU capabilities (default)
  //   "UseCPU": false,
  //   "SelectedDeviceIndex": 1, // 0 = CPU, 1 = first GPU/accelerator (WebGPU, CUDA, DirectML, OpenVINO, MIGraphX), 2 = second, etc.
  //   "RemoteOnly": false,
  //   "PreferredModelArchitectures": "FDAT_M,ESRGAN,SPAN,FDAT_XL,DAT2,HAT_L", // Optional: preference order of model architectures when several fit the same scale, most preferred first. Names: "ESRGAN", "SPAN", "FDAT_M", "FDAT_XL", "DAT2", "HAT_L". Unlisted architectures keep their built-in order after the listed ones; an unknown name fails startup. Promote "FDAT_XL" for quality at the cost of speed.
  //   "PreferredGpuBackend": "Auto", // Options: "Auto", "WebGPU", "CUDA", "DirectML", "OpenVINO", "MIGraphX", "CPU". Set by name — a numeric value that names no backend fails startup.
  //   "TileSize": 0, // 0 = plan the tile grid from the measured memory budget (default); negative = one tile over the whole page; positive = a fixed tile size, at least 64 px (4x the 16 px blend pad).
  //   "MemoryBudgetBytes": null, // Optional explicit memory budget (e.g. "4GiB") for tile planning, overriding the measured free VRAM. Also sizes the split detector's inference windows.
  //   "VramUtilizationFraction": null, // Optional fraction of the measured free VRAM the planner may use (default: built-in; 0 or unset = automatic, otherwise at least 0.1). Only meaningful with TileSize 0.
  //   "VramSafetyMarginBytes": null, // Optional bytes reserved out of the measured budget (e.g. "1GiB"; default: built-in).
  //   "VramExclusiveThresholdBytes": null, // Optional threshold under which the card is treated as exclusive to this app (default: built-in).
  //   "RecalibrateDeviceMemory": false, // Set to true to re-run the per-device memory calibration on the next upscale.
  //   "UpscaleTimeout": "00:01:00", // Per-million-pixel inactivity timeout. The effective timeout is scaled by image size: a 2 MP image gets 2× this value, a 0.5 MP image still gets the full value. Default: 1 minute.
  //   "MaxDimensionBeforeUpscaling": null, // Optional: Set to a number (e.g., 2048) to resize images larger than this dimension before upscaling
  //   "EnableSmartDownscale": true, // Downscale image formats like PNG that the upscaler handles poorly before upscaling.
  //   "SmartDownscaleThreshold": 15.0, // Laplacian standard deviation under which a page counts as "cheap" and is downscaled first.
  //   "SmartDownscaleFactor": 0.75, // Fraction of the original dimension a downscaled page keeps.
  //   "ImageFormatConversionRules": [ // Optional: Convert specific image formats to other formats before upscaling. Unset keeps the built-in PNG/AVIF -> JPG (quality 98) rules; set to [] to disable conversion.
  //     {
  //       "FromFormat": ".png",
  //       "ToFormat": ".jpg",
  //       "Quality": 98  // High quality to preserve image fidelity
