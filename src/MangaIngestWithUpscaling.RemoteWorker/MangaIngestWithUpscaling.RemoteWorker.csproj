<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>false</PublishAot>
    <VelopackRelease>false</VelopackRelease>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <!-- Local development secrets (WorkerConfig:ApiKey) live in user secrets, not in a tracked
         appsettings file: they are read automatically in Development and are never deployed. A
         container has no user secrets, so it is configured through Ingest_WorkerConfig__ApiKey or a
         mounted appsettings file instead. -->
    <UserSecretsId>manga-ingest-with-upscaling-remote-worker</UserSecretsId>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VelopackRelease)'=='true'">
    <DefineConstants>$(DefineConstants);VELOPACK_RELEASE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Protobuf
      Include="../MangaIngestWithUpscaling/protos/upscaling-dist.proto"
      GrpcServices="Client"
    >
      <Link>Protos\upscaling-dist.proto</Link>
    </Protobuf>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AutoRegisterInject" Version="2.0.3" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageReference Include="Microsoft.Build" Version="18.9.6" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.9.6" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.9.6" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.9.6" />
    <PackageReference Include="Open.ChannelExtensions" Version="10.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MangaIngestWithUpscaling.Shared\MangaIngestWithUpscaling.Shared.csproj" />
  </ItemGroup>
</Project>
