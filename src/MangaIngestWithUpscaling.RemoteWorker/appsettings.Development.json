  //    "UseCPU": false,
  //    "SelectedDeviceIndex": 0,
  //    "PreferredGpuBackend": "Auto",
  //    "MaxDimensionBeforeUpscaling": null,
  //    "ImageFormatConversionRules": [ // Optional: Convert specific image formats to other formats before upscaling. Unset keeps the built-in PNG/AVIF -> JPG (quality 98) rules; set to [] to disable conversion.
  //      {
  //        "FromFormat": ".png",
  //        "ToFormat": ".jpg",
  //        "Quality": 98  // High quality to preserve image fidelity
  //      },
  //      {
  //        "FromFormat": ".avif",
  //        "ToFormat": ".jpg",
  //        "Quality": 98
  //      }
  //    ]
  //  }
}
