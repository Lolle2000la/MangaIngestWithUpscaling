{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "System": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "MangaIngestWithUpscaling": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        // Which execution provider a session is built with is Debug in production; keep it visible
        // while developing, where it is the answer to "why is this slow / why did it fall back?".
        "MangaIngestWithUpscaling.Shared.Services.Inference.OnnxSessionFactory": "Debug"
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      // Same as the base configuration, deliberately: the container healthcheck uses wget, which is
      // HTTP/1.1-only, so an Http2-only listener here would reset every local `dotnet run` probe.
      "Protocols": "Http1AndHttp2"
    }
  },
  // The API key is a per-developer secret and deliberately not in this file. Set it with
  //   dotnet user-secrets set "WorkerConfig:ApiKey" "<key>" --project src/MangaIngestWithUpscaling.RemoteWorker
  // User secrets are read in Development only and are never deployed, so a container is configured
  // through Ingest_WorkerConfig__ApiKey (or a mounted appsettings file) instead.
  "WorkerConfig": {
    "ApiUrl": "https://localhost:7211"
  }
