{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Server.Kestrel": "Error",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "WorkerConfig": {
    "ApiKey": "<PUT YOUR API KEY HERE>",
    "ApiUrl": "https://your.mangaingest.tld"
    // Uploads resume automatically after a dropped connection. These knobs tune that behavior:
    // "UploadMaxAttempts": 10,                       // Hard cap on attempts before the task is reported failed
    // "UploadRetryBaseDelay": "00:00:10",            // First retry delay; backs off exponentially (capped at 5 minutes)
    // "UploadRetryMaxElapsed": "00:10:00",           // How long to keep retrying before giving up
    // "UploadTimeoutFloor": "00:02:00",              // Minimum per-attempt gRPC deadline
    // "UploadMinThroughputBytesPerSecond": 131072    // Assumed worst-case speed used to size the deadline
  },
  //  "Upscaler": {
  //    "UseFp16": true,
  //    "UseCPU": false,
  //    "SelectedDeviceIndex": 1, // 0 = CPU, 1 = first GPU/accelerator (CUDA/ROCm/XPU/MPS), 2 = second, etc.
  //    "PreferredGpuBackend": "Auto",
  //    "UpscaleTimeout": "00:01:00", // Per-million-pixel inactivity timeout. The effective timeout is scaled by image size: a 2 MP image gets 2× this value, a 0.5 MP image still gets the full value. Default: 1 minute.
  //    "MaxDimensionBeforeUpscaling": null,
  //    "ImageFormatConversionRules": [ // Optional: Convert specific image formats to other formats before upscaling. By default, PNG and AVIF images are converted to JPG with quality 98 for upscaler compatibility. Set to [] to disable.
  //      {
  //        "FromFormat": ".png",
  //        "ToFormat": ".jpg",
  //        "Quality": 98  // High quality to preserve image fidelity
  //      },
  //      {
  //        "FromFormat": ".avif",
  //        "ToFormat": ".jpg",
  //        "Quality": 98
  //      }
  //    ]
  //  }
}