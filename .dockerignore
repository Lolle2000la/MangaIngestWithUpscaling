**/.classpath
**/.dockerignore
**/.env
# The .git directory itself is deliberately not excluded (`.git/*`, not `**/.git`): excluding the
# directory prunes it from the build-context walk, and a later `!` cannot re-include a file once its
# parent directory has been excluded. Only its contents are filtered, so the entries at the bottom
# of this file can bring back the handful of files the SDK needs.
.git/*
**/.gitignore
**/.project
**/.settings
**/.toolstarget
**/.vs
**/.vscode
**/*.*proj.user
**/*.dbmdl
**/*.jfm
**/azds.yaml
**/bin
**/charts
**/docker-compose*
**/Dockerfile*
**/node_modules
**/npm-debug.log
**/obj
**/secrets.dev.yaml
**/values.dev.yaml
LICENSE
README.md
!**/.gitignore

# Deliberately kept out of the `.git/*` exclusion above: the .NET SDK reads HEAD/refs/packed-refs to
# stamp the source revision into AssemblyInformationalVersion ("1.0.0+<sha>"), which EngineIdentity
# hashes as the build half of a worker's engine identity. Without them every image claims the same
# build, so a worker on an older upscaler build could add pages to another one's half-spooled chapter.
# Negating `.git/refs` re-includes that whole subtree, which is what carries loose branch/tag refs;
# `packed-refs` carries the packed form.
!.git/HEAD
!.git/packed-refs
!.git/refs
test_data/

# Local-only caches that a clean CI checkout never has (for example a pip/npm/IDE cache directory).
# Excluding them keeps local image builds representative of CI and stops a checkout's caches from
# being baked into images.
**/.cache

# Model weights and their PyTorch-era leftovers. A checkout that has run the app can hold gigabytes
# of these next to the source, and the Dockerfile never needs them (the container downloads its own
# into the mounted models directory).
**/*.onnx
**/*.pth
**/*.safetensors

# Databases, their sidecars and startup markers created by running the app from a checkout. In the
# container these live on the /data volume instead.
**/*.db
**/*.db-wal
**/*.db-shm
**/*.db.bak
**/*.corrupted.*
**/.net10-upgrade-complete

# Local test / IDE / miscellaneous artifacts
**/test_env/
**/.idea/
**/.reasonix/
**/*.DotSettings.user
**/*.cbz
