# This file is tracked on purpose and contains no secrets. Compose never auto-enables profiles,
# so without COMPOSE_PROFILES=default below a fresh clone would start only `kavita` and skip the
# app service. Keep per-host overrides in docker-compose.override.yml or the environment instead.

# The standard app service lives in the `default` profile so that selecting the `remote-only`
# profile starts the remote-only service instead of it (the unprofiled `kavita` service starts
# either way). `COMPOSE_PROFILES=remote-only docker compose up` sets that profile in the
# environment, so this file cannot override it; `docker compose --profile remote-only up` is
# equivalent on current Compose. Compose never auto-starts a profiled service, so the plain
# `docker compose up` (and the documented `docker compose --profile postgres up`) behaviour is
# unchanged.
COMPOSE_PROFILES=default
